# Bright Riders School – Digital Canteen Ordering & Payment Solution
# Copy this file to `.env` and configure your environment secrets before production deployment.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database file path (SQLite with WAL persistence)
DATABASE_PATH=./server/data/canteen.sqlite

# Cryptographic Secrets (Generate strong 64+ char random hex strings in production)
JWT_SECRET=replace-with-strong-random-64-char-jwt-secret
QR_HMAC_SECRET=replace-with-strong-random-64-char-qr-hmac-secret

# School & Currency Configuration
SCHOOL_NAME="Bright Riders School"
SCHOOL_CAMPUS="Abu Dhabi Campus, UAE"
CURRENCY_CODE=AED

# Payment Gateway Configuration (Stripe UAE AED Support)
# Leave STRIPE_SECRET_KEY blank to run in clearly labelled UAE AED Sandbox Mode.
# Provide live or test Stripe keys (supporting AED merchant accounts in UAE) to enable real Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:3000

# Optional Bootstrap Passwords for Initial Accounts (Used only on first empty DB bootstrap)
# Never hardcode passwords in source code; override these in .env when initializing.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEMO_ACCOUNTS=true
