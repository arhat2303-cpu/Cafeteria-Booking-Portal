# Bright Riders School – Digital Canteen Ordering & Payment Portal
# Copy this file to `.env` and configure your environment secrets before production deployment.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database file path (SQLite with WAL persistence)
DATABASE_PATH=./server/data/canteen.sqlite

# Cryptographic Signing Secrets (Generate strong 64+ char random hex strings in production)
JWT_SECRET=replace-with-strong-random-64-char-jwt-secret
QR_HMAC_SECRET=replace-with-strong-random-64-char-qr-hmac-secret

# School & Currency Configuration
SCHOOL_NAME="Bright Riders School"
SCHOOL_CAMPUS="Abu Dhabi Campus, UAE"
CURRENCY_CODE=AED

# Stripe TEST checkout only: use sk_test_... and a test-mode whsec_... secret.
# Configure a public HTTPS URL and register the test webhook (see README).
# Live payments and real refunds remain disabled; never paste secrets into chat.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:3000
